{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "小红书媒体解析 API",
    "version": "0.1.0",
    "description": "面向小流量单机 VPS：调用方提供单个小红书链接，服务匿名获取页面并返回有序图片（每张可带对应实况 MP4）或普通视频笔记的一个主视频 MP4 直链，不使用小红书账号登录。X-API-Key 是本站调用密钥，与小红书账号、密码及 Cookie 无关。仅缓存成功结果，默认 TTL 120 秒。v1 不代理下载、不上传媒体、不验证媒体文件内容；媒体源尺寸等字段来自网页元数据。所有示例 media.example.com URL 都是占位地址。框架与反向代理可控制的错误响应均应为 application/json；网络断连等无 HTTP 响应的情形不在 JSON 保证范围。"
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/v1/xiaohongshu/parse": {
      "post": {
        "operationId": "parseXiaohongshuNote",
        "summary": "解析单个小红书笔记的图片或 MP4 直链",
        "description": "接受完整长链接、xhslink.com 短链或手机复制的 xhslink.cn/o/<token> 短链，保留分享参数。短链解析后仍需校验目标域名、路径和笔记 ID；xhslink.cn 的相似域名、子域及其他路径不受支持。图文中的实况图以静态图片及其嵌套 live_video 返回；顶层 videos 仍只用于普通视频笔记。整段分享文案、批量链接、登录受限内容和不受支持的媒体类型不在 v1 成功范围内。请求必须携带本站 X-API-Key。",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功提取受支持的正文媒体。示例媒体 URL 仅为占位，不是真实下载地址。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseSuccess"
                },
                "examples": {
                  "image": {
                    "value": {
                      "success": true,
                      "data": {
