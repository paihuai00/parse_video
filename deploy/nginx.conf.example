# Add this server block after choosing a domain and certificate paths. It does not proxy media.
server {
    listen 443 ssl http2;
    server_name parser.example.com;

    ssl_certificate /etc/letsencrypt/live/parser.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/parser.example.com/privkey.pem;

    client_max_body_size 8k;
    proxy_intercept_errors off;

    error_page 413 = @json_413;
    error_page 502 = @json_502;
    error_page 503 = @json_503;
    error_page 504 = @json_504;

    location = /healthz {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_read_timeout 5s;
    }

    location = /api/v1/xiaohongshu/parse {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-API-Key $http_x_api_key;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 6s;
        proxy_read_timeout 25s;
        proxy_send_timeout 25s;
    }

    location = /api/v1/parse {
        error_page 413 = @json_generic_413;
        error_page 502 = @json_generic_502;
        error_page 503 = @json_generic_503;
        error_page 504 = @json_generic_504;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-API-Key $http_x_api_key;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 6s;
        proxy_read_timeout 25s;
        proxy_send_timeout 25s;
    }

    location @json_413 {
        default_type application/json;
        return 413 '{"success":false,"data":null,"error":{"code":"INPUT_TOO_LARGE","message":"请求体超过允许的大小。","retryable":false},"meta":{"request_id":"$request_id","parsed_at":null,"cache":null}}';
    }
    location @json_502 {
        default_type application/json;
        return 502 '{"success":false,"data":null,"error":{"code":"UPSTREAM_BAD_RESPONSE","message":"小红书返回了无法处理的响应。","retryable":true},"meta":{"request_id":"$request_id","parsed_at":null,"cache":null}}';
    }
    location @json_503 {
        default_type application/json;
        add_header Retry-After 2 always;
        return 503 '{"success":false,"data":null,"error":{"code":"BUSY","message":"服务当前繁忙，请稍后重试。","retryable":true},"meta":{"request_id":"$request_id","parsed_at":null,"cache":null}}';
    }
    location @json_504 {
        default_type application/json;
        return 504 '{"success":false,"data":null,"error":{"code":"UPSTREAM_TIMEOUT","message":"获取或解析小红书页面超时。","retryable":true},"meta":{"request_id":"$request_id","parsed_at":null,"cache":null}}';
    }
    location @json_generic_413 {
        default_type application/json;
        return 413 '{"success":false,"data":null,"error":{"code":"INPUT_TOO_LARGE","message":"请求体超过允许的大小。","retryable":false},"meta":{"request_id":"$request_id","parsed_at":null,"cache":null}}';
    }
    location @json_generic_502 {
        default_type application/json;
        return 502 '{"success":false,"data":null,"error":{"code":"UPSTREAM_BAD_RESPONSE","message":"内容平台返回了无法处理的响应。","retryable":true},"meta":{"request_id":"$request_id","parsed_at":null,"cache":null}}';
    }
    location @json_generic_503 {
        default_type application/json;
        add_header Retry-After 2 always;
        return 503 '{"success":false,"data":null,"error":{"code":"BUSY","message":"服务当前繁忙，请稍后重试。","retryable":true},"meta":{"request_id":"$request_id","parsed_at":null,"cache":null}}';
    }
    location @json_generic_504 {
        default_type application/json;
        return 504 '{"success":false,"data":null,"error":{"code":"UPSTREAM_TIMEOUT","message":"获取或解析作品页面超时。","retryable":true},"meta":{"request_id":"$request_id","parsed_at":null,"cache":null}}';
    }
}
