# Required in production. Generate a long random value; never commit the real .env.
XHS_API_KEY=
XHS_ENV=production
XHS_IMPERSONATE=chrome136
XHS_REQUEST_TIMEOUT_SECONDS=20
XHS_CONNECT_TIMEOUT_SECONDS=5
XHS_UPSTREAM_CONCURRENCY=2
XHS_QUEUE_CAPACITY=4
XHS_QUEUE_WAIT_SECONDS=2
XHS_CACHE_TTL_SECONDS=120
XHS_CACHE_MAX_ENTRIES=256
XHS_RATE_LIMIT_PER_MINUTE=20
XHS_MAX_REDIRECTS=3
XHS_MAX_HTML_BYTES=2097152
XHS_DOUYIN_BROWSER_CONCURRENCY=1
XHS_DOUYIN_BROWSER_MAX_REQUESTS=500
XHS_DOUYIN_BROWSER_MAX_BYTES=33554432
XHS_DOUYIN_STATE_MAX_BYTES=2097152
# Set to chrome only for local development with an installed Google Chrome.
XHS_DOUYIN_BROWSER_CHANNEL=

# Staged rollout: false returns legacy CDN URLs; true publishes VPS URLs on both parse routes.
# The new client must not direct-download CDN URLs while this switch is false.
MEDIA_PUBLICATION_ENABLED=false
MEDIA_PUBLIC_ORIGIN=https://parser.example.com
# Independent server-only random secret, at least 32 bytes. Never put in client code.
MEDIA_SIGNING_KEY=
MEDIA_TICKET_TTL_SECONDS=1800
MEDIA_TICKET_MAX_ENTRIES=2048
MEDIA_TICKET_MAX_BYTES=2097152
MEDIA_CONCURRENCY=2
MEDIA_QUEUE_CAPACITY=4
MEDIA_QUEUE_WAIT_SECONDS=2
MEDIA_TIMEOUT_SECONDS=480
MEDIA_IDLE_TIMEOUT_SECONDS=30
MEDIA_MAX_BYTES=209715200
MEDIA_RATE_LIMIT_PER_MINUTE=120
PROVIDER_MAX_JSON_BYTES=1048576
# Used only by the fixed server-side ifphp provider; missing key skips that provider.
IFPHP_API_KEY=
