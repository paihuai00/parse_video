                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "$ref": "#/components/responses/Error405"
          },
          "413": {
            "$ref": "#/components/responses/Error413"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "502": {
            "$ref": "#/components/responses/Error502"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          },
          "504": {
            "$ref": "#/components/responses/Error504"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "检查本地服务进程是否能响应",
        "description": "无需 API Key；仅检查本地进程健康，不访问小红书，不验证匿名解析能力、缓存或媒体地址。",
        "security": [],
        "responses": {
          "200": {
            "description": "本地进程可响应。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "本站 API 调用密钥。不是小红书登录凭据；调用方不得提交小红书 Cookie、账号或密码。"
      }
    },
    "schemas": {
      "ParseRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "maxLength": 4096,
            "description": "单个完整 HTTP(S) 小红书笔记链接。支持 www.xiaohongshu.com/discovery/item/{note_id}、www.xiaohongshu.com/explore/{note_id}、xhslink.com 短链和手机复制的精确 xhslink.cn/o/<token>。保留 xsec_token 等分享参数。不接受整段分享文案、链接数组、xhslink.cn 的其他路径或任意站点 URL。",
            "examples": [
              "https://www.xiaohongshu.com/explore/6ad1f8610000000018018eef?xsec_token=EXAMPLE_TOKEN&xsec_source=pc_share"
            ]
          },
          "refresh": {
            "type": "boolean",
            "default": false,
            "description": "跳过本服务解析缓存重新获取页面；仍受密钥、限流和并发约束，不表示刷新小红书内容或延长媒体直链寿命。"
          }
        }
      },
      "ImageMedia": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "source_width",
          "source_height",
          "url_expires_at",
          "verification",
          "index"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "description": "页面提取的媒体直链；不保证永久有效，也不保证所有调用环境都可直接访问。示例 media.example.com 仅为占位，不是真实媒体地址。"
          },
          "source_width": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "网页提供的宽度元数据；未下载文件核验，未知为 null。"
          },
          "source_height": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "网页提供的高度元数据；未下载文件核验，未知为 null。"
          },
          "url_expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "上游明确提供的媒体地址失效时间；未知为 null，不使用本服务缓存到期时间代替。"
          },
          "verification": {
            "type": "string",
            "const": "not_checked",
            "description": "v1 仅提取链接，不请求媒体文件；未检查响应文件头、部分内容、完整下载或播放。"
          },
          "index": {
            "type": "integer",
            "minimum": 1,
            "description": "正文图片在笔记中的顺序，从 1 开始，连续递增。"
          },
          "live_video": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/VideoMedia"
              },
              {
                "type": "null"
              }
            ],
            "description": "该图片为实况图时选中的动态 MP4；与当前图片位置绑定。普通图片省略此字段。动态流未提供的元数据为 null，不能从静态图宽高推断。"
          }
        }
      },
      "CoverMedia": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "source_width",
          "source_height",
          "url_expires_at",
          "verification"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "description": "页面提取的媒体直链；不保证永久有效，也不保证所有调用环境都可直接访问。示例 media.example.com 仅为占位，不是真实媒体地址。"
          },
          "source_width": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "网页提供的宽度元数据；未下载文件核验，未知为 null。"
          },
          "source_height": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "网页提供的高度元数据；未下载文件核验，未知为 null。"
          },
          "url_expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "上游明确提供的媒体地址失效时间；未知为 null，不使用本服务缓存到期时间代替。"
          },
          "verification": {
            "type": "string",
            "const": "not_checked",
            "description": "v1 仅提取链接，不请求媒体文件；未检查响应文件头、部分内容、完整下载或播放。"
          }
        },
        "description": "视频封面，不计入正文图片或主视频数量。"
      },
      "VideoMedia": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "source_width",
          "source_height",
          "url_expires_at",
          "verification",
          "format",
          "codec",
          "quality",
          "duration_seconds",
          "size_bytes"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "description": "页面提取的媒体直链；不保证永久有效，也不保证所有调用环境都可直接访问。示例 media.example.com 仅为占位，不是真实媒体地址。"
          },
          "source_width": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "网页提供的宽度元数据；未下载文件核验，未知为 null。"
          },
          "source_height": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "网页提供的高度元数据；未下载文件核验，未知为 null。"
          },
          "url_expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "上游明确提供的媒体地址失效时间；未知为 null，不使用本服务缓存到期时间代替。"
          },
          "verification": {
            "type": "string",
            "const": "not_checked",
            "description": "v1 仅提取链接，不请求媒体文件；未检查响应文件头、部分内容、完整下载或播放。"
          },
          "format": {
            "type": "string",
            "const": "mp4",
            "description": "依据上游媒体数据选择 MP4；不表示已下载校验文件容器。"
          },
          "codec": {
            "type": [
              "string",
              "null"
            ],
            "description": "上游提供的编码信息，未知为 null。"
          },
          "quality": {
            "type": [
              "string",
              "null"
            ],
            "description": "上游提供的质量标签，未知为 null；不保证原始视频质量。"
          },
          "duration_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "网页提供的时长，单位秒；未知为 null。"
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "网页提供的文件大小，单位字节；未知为 null，未下载核验。"
          }
        }
      },
      "ImageNote": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "note_id",
          "title",
          "type",
          "images",
          "videos",
          "cover"
        ],
        "properties": {
          "note_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "笔记标题，无法取得时为 null。"
          },
          "type": {
            "type": "string",
            "const": "image"
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ImageMedia"
            },
            "description": "全部正文静态图片按原笔记顺序排列。实况图在所属图片的 live_video 中带一个选中的 MP4；缺少受支持动态 MP4 时不得静态降级为成功。"
          },
          "videos": {
            "type": "array",
            "maxItems": 0,
            "items": {
              "$ref": "#/components/schemas/VideoMedia"
            }
          },
          "cover": {
            "type": "null"
          }
        },
        "description": "普通图文或包含实况图的图文；images 至少有一项，实况动态 MP4 只嵌套在所属图片，videos 为空，cover 为 null。"
      },
      "VideoNote": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "note_id",
          "title",
          "type",
          "images",
          "videos",
          "cover"
        ],
        "properties": {
          "note_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "笔记标题，无法取得时为 null。"
          },
          "type": {
            "type": "string",
            "const": "video"
          },
          "images": {
            "type": "array",
            "maxItems": 0,
            "items": {
              "$ref": "#/components/schemas/ImageMedia"
            }
          },
          "videos": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/VideoMedia"
            },
            "description": "v1 恰好返回一个选中的主视频 MP4，不包含音轨、HLS 或重复清晰度。"
          },
          "cover": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CoverMedia"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "description": "视频笔记必须取得主视频 MP4；只有封面不构成成功。"
      },
      "ParsedNote": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ImageNote"
          },
          {
            "$ref": "#/components/schemas/VideoNote"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "image": "#/components/schemas/ImageNote",
            "video": "#/components/schemas/VideoNote"
          }
        },
        "description": "v1 支持普通图文、带嵌套动态 MP4 的实况图文和单主视频；不支持的直播或未知混合媒体返回 UNSUPPORTED_CONTENT。"
      },
      "CacheMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hit",
          "expires_at"
        ],
        "properties": {
          "hit": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "本服务解析结果缓存到期时间。默认成功结果缓存 120 秒；不代表媒体直链的有效期。"
          }
        }
      },
      "ResponseMeta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "parsed_at",
          "cache"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "parsed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "成功提取笔记数据的 UTC 时间；缓存命中时保留原提取时间，失败为 null。"
          },
          "cache": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CacheMetadata"
              },
              {
                "type": "null"
              }
            ],
            "description": "成功结果的缓存信息；失败为 null，仅缓存成功结果。"
          }
        }
      },
      "ErrorDetails": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_URL",
              "UNAUTHORIZED",
              "NOTE_NOT_FOUND",
              "ROUTE_NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "INPUT_TOO_LARGE",
              "UNSUPPORTED_CONTENT",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "UPSTREAM_BAD_RESPONSE",
              "PARSE_FAILED",
              "MEDIA_NOT_FOUND",
              "BUSY",
              "UPSTREAM_LOGIN_REQUIRED",
              "UPSTREAM_ACCESS_RESTRICTED",
              "UPSTREAM_RATE_LIMITED",
              "UPSTREAM_TIMEOUT"
            ]
          },
          "message": {
            "type": "string",
            "description": "可供人阅读的错误说明；调用方应依据 code 处理，不依赖具体文案。"
          },
